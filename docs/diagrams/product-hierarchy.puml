@startuml product-hierarchy
skinparam classAttributeIconSize 0
hide empty members
title Product hierarchy (Tutorial 5)

abstract class Product {
  - id : Long
  - name : String
  - price : double
  + {abstract} getSummary() : String
  + getName() : String
  + getPrice() : double
}

interface Discountable {
  + applyDiscount(rate : double) : void
  + getDiscountedPrice() : double
}

class DigitalProduct {
  - downloadUrl : String
  - fileSizeMB : double
  + getSummary() : String
  + applyDiscount(rate : double) : void
}

class PhysicalProduct {
  - weightKg : double
  - dimensions : String
  + getSummary() : String
  + applyDiscount(rate : double) : void
}

class BundleProduct {
  - items : List<Product>
  + getSummary() : String
}

' Generalisation (extends): SOLID line, hollow triangle at Product
Product <|-- DigitalProduct
Product <|-- PhysicalProduct
Product <|-- BundleProduct

' Realisation (implements): DASHED line, hollow triangle at Discountable
Discountable <|.. DigitalProduct
Discountable <|.. PhysicalProduct

' A bundle HAS products (composition of the catalogue items)
BundleProduct o--> "0..*" Product : items
@enduml
